        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoServico\": \"Eletricidade\",\n  \"titulo\": \"Revisão elétrica\",\n  \"descricao\": \"Rever a instalação elétrica.\",\n  \"dataPretendida\": \"2026-10-15\",\n  \"valorPrevisto\": 20000,\n  \"competenciasExigidas\": \"Eletricista qualificado.\",\n  \"inicioCandidatura\": \"2026-09-01\",\n  \"fimCandidatura\": \"2026-09-30\",\n  \"telefone\": \"+238 999 00 00\",\n  \"email\": \"kevin@dge.cv\",\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
