{
  "info": {
    "_postman_id": "0efad814-b3f9-46cb-92db-prestacao-servicos-contratante",
    "name": "Perfil Candidato - Prestação de Serviços - Como Contratante",
    "description": "Endpoints para gerir serviços registados pelo contratante e consultar/selecionar candidatos. Os anexos são opcionais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Opções do formulário",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/opcoes?ilha={{ilha}}&concelho={{concelho}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "opcoes"],
          "query": [
            {"key": "ilha", "value": "{{ilha}}", "disabled": true},
            {"key": "concelho", "value": "{{concelho}}", "disabled": true}
          ]
        },
        "description": "Devolve estados, ilhas e, quando informados os pais, concelhos e zonas."
      },
      "response": []
    },
    {
      "name": "Registar serviço ativo sem anexos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Serviço criado', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.dados && json.dados.servicoId) pm.collectionVariables.set('servicoId', json.dados.servicoId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoServico\": \"Canalização\",\n  \"titulo\": \"Reparação da instalação\",\n  \"descricao\": \"Reparar uma fuga de água.\",\n  \"dataPretendida\": \"2026-10-10\",\n  \"valorPrevisto\": 15000.00,\n  \"competenciasExigidas\": \"Experiência em canalização.\",\n  \"inicioCandidatura\": \"2026-09-01\",\n  \"fimCandidatura\": \"2026-09-30\",\n  \"ilha\": null,\n  \"concelho\": null,\n  \"zona\": null,\n  \"telefone\": \"+238 999 00 00\",\n  \"email\": \"kevin@dge.cv\",\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Cria em estado A (Ativo). Este cenário confirma que os anexos não são obrigatórios."
      },
      "response": []
    },
    {
      "name": "Registar serviço ativo com documentos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Serviço com documentos criado', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.dados && json.dados.servicoId) pm.collectionVariables.set('servicoId', json.dados.servicoId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "dados",
              "value": "{\"tipoServico\":\"Canalização\",\"titulo\":\"Reparação da instalação\",\"descricao\":\"Reparar uma fuga de água.\",\"dataPretendida\":\"2026-10-10\",\"valorPrevisto\":15000.00,\"competenciasExigidas\":\"Experiência em canalização.\",\"inicioCandidatura\":\"2026-09-01\",\"fimCandidatura\":\"2026-09-30\",\"telefone\":\"+238 999 00 00\",\"email\":\"kevin@dge.cv\",\"utilizador\":\"{{utilizador}}\"}",
              "type": "text",
              "contentType": "application/json"
            },
            {"key": "documentos", "type": "file", "src": ""}
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        }
      },
      "response": []
    },
    {
      "name": "Guardar como rascunho",
