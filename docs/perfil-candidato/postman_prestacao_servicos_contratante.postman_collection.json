    {
      "name": "Consultar detalhe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        }
      },
      "response": []
    },
    {
      "name": "Atualizar sem novos anexos",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoServico\": \"Canalização\",\n  \"titulo\": \"Reparação da instalação - atualizado\",\n  \"descricao\": \"Reparar uma fuga de água.\",\n  \"dataPretendida\": \"2026-10-10\",\n  \"valorPrevisto\": 16000.00,\n  \"competenciasExigidas\": \"Experiência em canalização.\",\n  \"inicioCandidatura\": \"2026-09-01\",\n  \"fimCandidatura\": \"2026-09-30\",\n  \"telefone\": \"+238 999 00 00\",\n  \"email\": \"kevin@dge.cv\",\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Quando anexosMantidos é omitido e não existem novos ficheiros, preserva todos os anexos atuais."
      },
      "response": []
    },
    {
      "name": "Opções dos candidatos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}/candidatos/opcoes?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}", "candidatos", "opcoes"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        }
      },
      "response": []
    },
    {
      "name": "Listar candidatos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}/candidatos?pessoaId={{pessoaId}}&estado=PENDENTE&dataInicio=2026-09-01&dataFim=2026-09-30",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}", "candidatos"],
          "query": [
            {"key": "pessoaId", "value": "{{pessoaId}}"},
            {"key": "candidatoId", "value": "{{candidatoId}}", "disabled": true},
            {"key": "estado", "value": "PENDENTE"},
            {"key": "dataInicio", "value": "2026-09-01"},
            {"key": "dataFim", "value": "2026-09-30"}
          ]
        }
      },
      "response": []
    },
    {
      "name": "Selecionar candidato",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}/candidatos/{{candidaturaId}}/selecionar?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}", "candidatos", "{{candidaturaId}}", "selecionar"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Atualiza status_candidatura para APROVADO, reutilizando o domínio já existente no projeto."
      },
      "response": []
    },
    {
      "name": "Cancelar serviço",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}/cancelar?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}", "cancelar"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Atualiza o estado para C (Cancelado)."
      },
      "response": []
    },
    {
      "name": "Remover serviço logicamente",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"utilizador\": \"{{utilizador}}\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante/{{servicoId}}/remover?pessoaId={{pessoaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "{{servicoId}}", "remover"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Não elimina fisicamente: atualiza o estado para E (Eliminado)."
      },
      "response": []
