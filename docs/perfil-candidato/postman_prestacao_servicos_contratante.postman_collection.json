          "raw": "{{baseUrl}}/v1/perfil-candidato/prestacoes-servicos/contratante?pessoaId={{pessoaId}}&tipoServico=Canalização&estado=A&dataInicio=2026-09-01&dataFim=2026-09-30",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante"],
          "query": [
            {"key": "pessoaId", "value": "{{pessoaId}}"},
