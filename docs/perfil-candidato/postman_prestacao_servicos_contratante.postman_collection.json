          "path": ["v1", "perfil-candidato", "prestacoes-servicos", "contratante", "rascunho"],
          "query": [{"key": "pessoaId", "value": "{{pessoaId}}"}]
        },
        "description": "Cria em estado R (Rascunho)."
      },
      "response": []
    },
    {
