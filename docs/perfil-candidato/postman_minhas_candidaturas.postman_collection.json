    {"key": "entidadeId", "value": "1"},
    {"key": "ilha", "value": "1"},
    {"key": "concelho", "value": "2"},
    {"key": "estado", "value": "TRIAGEM"},
    {"key": "codigoReferencia", "value": "REF"},
    {"key": "dataInicio", "value": "2026-01-01"},
    {"key": "dataFim", "value": "2026-12-31"}
  ]
}
