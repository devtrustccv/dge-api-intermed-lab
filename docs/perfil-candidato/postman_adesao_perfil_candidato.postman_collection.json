    "info":  {
                 "_postman_id":  "b283f124-0172-4208-b312-adesao-perfil-candidato",
                 "name":  "Perfil Candidato - Adesão",
                 "description":  "API de confirmação da adesão do jovem.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "item":  [
                 {
                     "name":  "Confirmar adesão",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"situacaoProfissional\": \"{{situacaoProfissional}}\",\n  \"utilizador\": \"{{utilizador}}\"\n}"
                                              },
                                     "url":  {
                                                 "raw":  "{{baseUrl}}/v1/perfil-candidato/adesao?pessoaId={{pessoaId}}",
                                                 "host":  [
                                                              "{{baseUrl}}"
                                                          ],
                                                 "path":  [
                                                              "v1",
                                                              "perfil-candidato",
                                                              "adesao"
                                                          ],
                                                 "query":  [
                                                               {
                                                                   "key":  "pessoaId",
                                                                   "value":  "{{pessoaId}}",
                                                                   "description":  "Identificador da pessoa com sessão ativa no portal."
                                                               }
                                                           ]
                                             },
                                     "description":  "Regista a situação profissional, resolve o id do utente no backend e grava a data atual e o email do utilizador da submissão. Os restantes campos do formulário são preenchidos por outra API."
                                 },
                     "response":  [

                                  ]
                 }
             ],
    "variable":  [
                     {
                         "key":  "baseUrl",
