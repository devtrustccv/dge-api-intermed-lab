                "colocacoes-candidatos",
                "candidatos"
              ],
              "query": [
                {
                  "key": "ofertaId",
                  "value": "{{ofertaId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Criar Colocacao",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.dados && json.dados.id) pm.collectionVariables.set('colocacaoId', json.dados.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoOferta\": \"OFERTA_EMPREGO\",\n  \"ofertaId\": {{ofertaId}},\n  \"pessoaId\": {{pessoaId}},\n  \"tipoContrato\": \"CONTRATO_TERMO\",\n  \"duracaoContrato\": 12,\n  \"dataInicioPrevisto\": \"2026-09-15\",\n  \"dataFimPrevisto\": \"2027-09-14\",\n  \"descricao\": \"Colocacao criada para teste no Postman.\",\n  \"contratoPath\": \"contratos/contrato-postman.pdf\",\n  \"utilizador\": \"postman\"\n}",
              "options": {
