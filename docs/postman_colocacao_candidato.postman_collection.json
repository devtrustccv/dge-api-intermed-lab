          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/colocacoes-candidatos?tipoOferta=OFERTA_EMPREGO&codigoReferencia={{codigoReferencia}}&pessoaId={{pessoaId}}&tipoContrato=CONTRATO_TERMO&dataInicioPrevisto=2026-09-15&dataRegistoInicio=2026-08-01&dataRegistoFim=2026-08-31&entidadeId={{entidadeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "colocacoes-candidatos"
              ],
              "query": [
                {
                  "key": "tipoOferta",
                  "value": "OFERTA_EMPREGO"
                },
                {
                  "key": "codigoReferencia",
                  "value": "{{codigoReferencia}}"
                },
                {
                  "key": "pessoaId",
                  "value": "{{pessoaId}}"
                },
                {
                  "key": "tipoContrato",
                  "value": "CONTRATO_TERMO"
                },
                {
                  "key": "dataInicioPrevisto",
                  "value": "2026-09-15"
                },
                {
                  "key": "dataRegistoInicio",
                  "value": "2026-08-01"
                },
                {
                  "key": "dataRegistoFim",
                  "value": "2026-08-31"
                },
                {
                  "key": "entidadeId",
                  "value": "{{entidadeId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Select Ofertas por Tipo e Entidade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.dados && json.dados.length > 0) {",
                  "    pm.collectionVariables.set('ofertaId', json.dados[0].ofertaId);",
                  "    pm.collectionVariables.set('codigoReferencia', json.dados[0].codigoReferencia);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/colocacoes-candidatos/ofertas?tipoOferta=OFERTA_EMPREGO&entidadeId={{entidadeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "colocacoes-candidatos",
                "ofertas"
              ],
              "query": [
                {
                  "key": "tipoOferta",
                  "value": "OFERTA_EMPREGO"
                },
                {
                  "key": "entidadeId",
                  "value": "{{entidadeId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Select Candidatos por Oferta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.dados && json.dados.length > 0) pm.collectionVariables.set('pessoaId', json.dados[0].pessoaId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/colocacoes-candidatos/candidatos?ofertaId={{ofertaId}}",
